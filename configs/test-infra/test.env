# source this file before `go test` to enable the optional PostgreSQL / real Redis suites.
# Values match configs/test-infra/docker-compose.yml and redis-test.acl (test-only secrets).
export GATEWAY_TEST_DATABASE_URL="postgres://gateway:gateway-test@127.0.0.1:15432/gateway_test?sslmode=disable"
export GATEWAY_TEST_REDIS_ADDR="127.0.0.1:16389"
export GATEWAY_TEST_REDIS_ADMIN_USERNAME="test-admin"
export GATEWAY_TEST_REDIS_ADMIN_PASSWORD="test-admin-secret"
export GATEWAY_TEST_REDIS_CONTROL_USERNAME="test-control"
export GATEWAY_TEST_REDIS_CONTROL_PASSWORD="test-control-secret"
export GATEWAY_TEST_REDIS_GATEWAY_USERNAME="test-gateway"
export GATEWAY_TEST_REDIS_GATEWAY_PASSWORD="test-gateway-secret"
export GATEWAY_TEST_REDIS_WRAPPER_USERNAME="test-wrapper"
export GATEWAY_TEST_REDIS_WRAPPER_PASSWORD="test-wrapper-secret"
